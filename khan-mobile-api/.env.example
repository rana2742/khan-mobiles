PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/khan_mobile_shop?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
COOKIE_NAME=khan_token
COOKIE_SECURE=true

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=

# --- Initial admin account ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@khanmobile.pk
ADMIN_PASSWORD=replace_me

# --- Order emails ---
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Khan Mobile Shop

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Weekly database backup ---
BACKUP_EMAIL_TO=
BACKUP_CRON_SCHEDULE=0 3 * * 0
BACKUP_ENABLED=true

# --- Leopards Merchant API ---
LEOPARDS_API_BASE_URL=https://merchantapi.leopardscourier.com/api/
LEOPARDS_API_KEY=your_leopards_api_key
LEOPARDS_API_PASSWORD=your_leopards_api_password

# Optional merchant/shipment configuration. Only set LEOPARDS_SHIPMENT_ID if Leopards has provided one for this account.
LEOPARDS_SHIPMENT_ID=
LEOPARDS_ORIGIN_CITY_ID=
LEOPARDS_SHIPMENT_TYPE=overnight
LEOPARDS_DEFAULT_WEIGHT_GRAMS=500
LEOPARDS_DEFAULT_PIECES=1
LEOPARDS_RETURN_CITY_ID=
LEOPARDS_RETURN_ADDRESS=
