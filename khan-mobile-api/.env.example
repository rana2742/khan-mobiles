PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/khan_mobile_shop?retryWrites=true&w=majority

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
COOKIE_NAME=khan_token
# Vercel/Railway are both HTTPS by default, so this should be true.
COOKIE_SECURE=true

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=

# --- Initial admin account (created by `npm run seed`) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@khanmobile.pk
ADMIN_PASSWORD=Admin@12345

# --- Order emails (Gmail SMTP) ---
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Khan Mobile Shop

# --- Cloudinary (product image storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Weekly database backup (emailed as a zip) ---
# Defaults to ADMIN_EMAIL if not set. Cron defaults to every Sunday 3 AM;
# override with standard 5-field cron syntax. Set BACKUP_ENABLED=false to disable.
BACKUP_EMAIL_TO=
BACKUP_CRON_SCHEDULE=0 3 * * 0
BACKUP_ENABLED=true
